#!/usr/bin/env bash
#
# Clean a filename by removing spaces and numbers and lowercasing it.
#
# Usage:
#   clean-filename <filename>
#

target=$(echo "$1" | sed 's|[0-9]*||g' | sed 's| |-|g' | sed 's|/-|/|g' | sed 's|-.png|.png|g' | sed 's|-.svg|.svg|g' | tr '[:upper:]' '[:lower:]' )

if [ "${target}" != "${1}" ]; then
	mv -v "${1}" "${target}"
else
	echo "Skipping ${1} -> ${target}"
fi
