#!/usr/bin/env bash
#
# Generate a .wp-env.json file for a WordPress project.
#
# Usage:
#   new-wp-env
#   new-wp-env theme
#   new-wp-env plugin
#

set -e

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
type="${1:-}"

if [ -n "$type" ] && [ "$type" != "theme" ] && [ "$type" != "plugin" ]; then
	echo "Usage: new-wp-env [theme|plugin]"
	exit 1
fi

if [ -f ".wp-env.json" ]; then
	echo ".wp-env.json already exists."
	exit 1
fi

port=$((RANDOM % 16384 + 49152))
tests_port=$((RANDOM % 16384 + 49152))

if [ -z "$type" ]; then
	# Full WordPress install — discover themes and plugins

	cat > .wp-env.json <<EOF
{
	"mappings": {
		"wp-content/mu-plugins": "./wp-content/mu-plugins",
		"wp-content/themes": "./wp-content/themes",
		"wp-content/plugins": "./wp-content/plugins",
		"wp-content/uploads": "./wp-content/uploads"
	},
	"port": ${port},
	"env": {
		"tests": {
			"port": ${tests_port}
		}
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": true
	}
}
EOF

	echo "Created .wp-env.json for full WordPress install"
else
	# Single theme or plugin
	cat > .wp-env.json <<EOF
{
	"${type}s": [ "." ],
	"port": ${port},
	"env": {
		"tests": {
			"port": ${tests_port}
		}
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": true
	}
}
EOF

	echo "Created .wp-env.json for $type: $(basename "$PWD")"
fi

# If there is an existing mu-plugin directory, add the local development plugin.
if [ -d "wp-content/mu-plugins" ]; then
	"${script_dir}/copy-local-wp"
fi

# Now start the environment unless the '--no-start' flag is passed.
if [ "$2" != "--no-start" ]; then
	echo "Starting the WordPress environment..."
	bunx wp-env start
fi
