#!/usr/bin/env bash

if [ -z "$1" ]; then
	echo "Usage: newbru <name> <url> [folder]"
	exit 1
fi

if [ -z "$2" ]; then
	echo "Usage: newbru <name> <url> [folder]"
	exit 1
fi

if [ -z "$3" ]; then
	folder="."
fi

order=0
name="$1"
url="$2"
folder="$3"

# If url doesn't have http:// or https://, add https://
if [[ ! "$url" =~ ^https?:// ]]; then
	url="https://$url"
fi

# If folder doesn't exist, create it
if [ ! -d "$folder" ]; then
	mkdir -p "$folder"
fi

# Find the highest order number in the folder
for file in "$folder"/*.bru; do
	if [ -f "$file" ]; then
		fileOrder=$(grep 'seq: ' "$file" | sed 's/^  seq: \([0-9]*\).*$/\1/')

		if [ "$fileOrder" -gt "$order" ]; then
			order="$fileOrder"
		fi
	fi
done

echo "Creating new bru file: $folder/$name.bru"

((order++))

echo "meta {
  name: $name
  type: http
  seq: $order
}

get {
  url: $url
  body: none
  auth: none
}" > "$folder/$name.bru"
