#!/usr/bin/env bash
#
# Display the current git repository root.
#
# Usage:
#   git root
#   git root --relative
#

##
# Print the repository root.
#
git_root() {
  git rev-parse --show-toplevel
}

##
# Print the current path relative to the repository root.
#
git_root_relative() {
    git rev-parse --show-prefix
}

if test $# -eq 0; then
    git_root
else
    case "$1" in
    -r|--relative)
        git_root_relative
        ;;
    *)
        git_root
        ;;
    esac
fi
